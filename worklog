#!/usr/bin/env bash
# Skróty do obsługi kontenera. Użycie: ./worklog [up|down|restart|logs|status|update|backup|restore PLIK|remind|uninstall|console ...]
set -euo pipefail

DIR="$(cd "$(dirname "$0")" && pwd)"
cd "$DIR"
[[ -f .env.compose ]] || printf 'WORKLOG_PORT=8765\nCOMPOSE_FILE=compose.yaml\n' > .env.compose
set -a; source .env.compose; set +a

dc() {
    local args=()
    IFS=':' read -ra files <<< "$COMPOSE_FILE"
    for f in "${files[@]}"; do args+=(-f "$f"); done
    docker compose --env-file .env.compose "${args[@]}" "$@"
}

# Kopię i przywracanie robi polecenie app:db w kontenerze (to samo co na Windowsie). Obraz zbudowany przed jego
# dodaniem (bez ./worklog up po git pull) nie ma go – wtedy ten sam kod PHP podany w wierszu poleceń.
has_db_command() { docker exec worklog php bin/console app:db --help >/dev/null 2>&1; }

legacy_backup() {
    docker exec worklog php -r '
        @unlink("/data/.backup.db");
        $db = new SQLite3("/data/worklog.db");
        $db->busyTimeout(10000);
        if (!$db->exec("VACUUM INTO \"/data/.backup.db\"")) { fwrite(STDERR, "VACUUM INTO nie powiodło się\n"); exit(1); }
        $check = (new SQLite3("/data/.backup.db", SQLITE3_OPEN_READONLY))->querySingle("PRAGMA integrity_check");
        if ($check !== "ok") { fwrite(STDERR, "Kopia uszkodzona: $check\n"); exit(1); }
    '
}

legacy_restore() {
    docker exec worklog php -r '
        $src = new SQLite3("/data/.restore.db", SQLITE3_OPEN_READONLY);
        if ($src->querySingle("PRAGMA integrity_check") !== "ok") { fwrite(STDERR, "Plik kopii jest uszkodzony – nic nie zmieniono.\n"); exit(1); }
        $dst = new SQLite3("/data/worklog.db");
        $dst->busyTimeout(10000);
        if (!$src->backup($dst)) { fwrite(STDERR, "Przywracanie nie powiodło się – nic nie zmieniono.\n"); exit(1); }
    '
}

case "${1:-help}" in
    up)       dc up -d --build ;;
    down)     dc down ;;
    restart)  dc restart ;;
    logs)     dc logs -f --tail=100 ;;
    status)   dc ps; echo; echo "http://127.0.0.1:$WORKLOG_PORT" ;;
    update)
        # composer.lock przypina wersje – najpierw podnosimy je do najnowszych łatek w ramach composer.json
        docker run --rm --user "$(id -u):$(id -g)" -e COMPOSER_HOME=/tmp/composer -v "$DIR":/app -w /app \
            composer:2 update --no-install --no-scripts --no-interaction
        dc build --pull --no-cache && dc up -d
        ;;
    backup)
        out="${2:-$HOME/worklog-backup-$(date +%Y%m%d-%H%M%S).db}"
        umask 077
        mkdir -p "$(dirname "$out")"
        # VACUUM INTO daje spójną kopię także wtedy, gdy aplikacja akurat zapisuje; potem sprawdzamy jej integralność
        if has_db_command; then
            docker exec worklog php bin/console app:db backup /data/.backup.db
        else
            legacy_backup
        fi
        docker exec worklog cat /data/.backup.db > "$out.part"
        docker exec worklog rm -f /data/.backup.db
        mv "$out.part" "$out"     # plik pojawia się dopiero, gdy jest kompletny
        echo "Kopia zapisana: $out"
        ;;
    restore)
        [[ -f "${2:-}" ]] || { echo "Użycie: ./worklog restore PLIK.db"; exit 1; }
        read -rp "Nadpisać obecne dane kopią $2? [t/N] " ok
        [[ "$ok" == "t" ]] || exit 1
        safety="${WORKLOG_BACKUP_DIR:-$HOME/worklog-backups}/przed-przywroceniem-$(date +%Y%m%d-%H%M%S).db"
        if ! "$0" backup "$safety" >/dev/null; then
            echo "Nie udało się zrobić kopii obecnego stanu – przerywam, nic nie zmieniono."
            exit 1
        fi
        echo "Obecny stan zapisano na wszelki wypadek: $safety"
        docker exec -i worklog sh -c 'umask 077; cat > /data/.restore.db' < "$2"
        # backup API SQLite – bezpieczne przy włączonym WAL i działającej aplikacji
        status=0
        if has_db_command; then
            docker exec worklog php bin/console app:db restore /data/.restore.db || status=$?
        else
            legacy_restore || status=$?
        fi
        docker exec worklog rm -f /data/.restore.db
        [[ $status -eq 0 ]] || exit 1
        # kopia sprzed zmian w bazie (np. bez tabeli urlopów): brakujące tabele i kolumny dochodzą od razu, nie po restarcie
        docker exec worklog php bin/console doctrine:schema:update --force --no-interaction --quiet
        echo "Przywrócono."
        ;;
    uninstall)
        # Usuwa wszystko, co założył install.sh. Kopie zapasowe zostają – to Twoje dane.
        backups="${WORKLOG_BACKUP_DIR:-$HOME/worklog-backups}"
        if [[ "${2:-}" != "--tak" ]]; then
            echo "Zostaną usunięte: kontener i obraz worklog, wolumen worklog-data (baza, token Jiry),"
            echo "timery systemd (przypomnienie, kopie) i skrót „Raport czasu” w menu."
            echo "Przedtem zrobię ostatnią kopię bazy do $backups. Kopie zapasowe i ten katalog zostają."
            read -rp "Odinstalować? [t/N] " ok
            [[ "$ok" == "t" ]] || exit 1
        fi

        if docker volume inspect worklog-data >/dev/null 2>&1; then
            if ! docker inspect -f '{{.State.Running}}' worklog 2>/dev/null | grep -q true; then
                echo "Kontener nie działa, więc nie zrobię ostatniej kopii. Uruchom go (./worklog up) i spróbuj ponownie."
                exit 1
            fi
            last="$backups/przed-odinstalowaniem-$(date +%Y%m%d-%H%M%S).db"
            if ! "$0" backup "$last" >/dev/null; then
                echo "Nie udało się zrobić ostatniej kopii – przerywam, nic nie usunięto."
                exit 1
            fi
            echo "Ostatnia kopia: $last"
        fi

        units="$HOME/.config/systemd/user"
        systemctl --user disable --now worklog-remind.timer worklog-backup.timer >/dev/null 2>&1 || true
        rm -f "$units"/worklog-{remind,backup}.{service,timer}
        systemctl --user daemon-reload 2>/dev/null || true
        rm -f "$HOME/.local/share/applications/worklog.desktop"

        dc down --rmi local >/dev/null 2>&1 || true
        docker rm -f worklog >/dev/null 2>&1 || true
        docker volume rm worklog-data >/dev/null 2>&1 || true
        docker image rm worklog-tool:latest >/dev/null 2>&1 || true
        rm -f .env.compose

        echo "Odinstalowano. Kopie zapasowe zostały w $backups."
        echo "Pamiętaj o unieważnieniu tokenu w Jirze, jeśli nie będzie już potrzebny."
        echo "Katalog z kodem ($DIR) możesz teraz usunąć ręcznie."
        ;;
    remind)   docker exec worklog php bin/console app:remind -v ;;
    console)  shift; docker exec -it worklog php bin/console "$@" ;;
    *)
        cat <<EOF
./worklog up        – zbuduj i uruchom
./worklog down      – zatrzymaj i usuń kontener (dane zostają w wolumenie)
./worklog restart   – restart
./worklog logs      – logi na żywo
./worklog status    – stan kontenera
./worklog update    – przebuduj obraz na najnowszych łatkach PHP/Symfony
./worklog backup    – kopia bazy do ~/worklog-backup-*.db
./worklog restore F – przywróć kopię
./worklog remind    – co zostało do zrobienia dzisiaj
./worklog uninstall – usuń wszystko (najpierw robi ostatnią kopię bazy)
EOF
        ;;
esac
