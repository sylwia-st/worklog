# Wartości awaryjne. W kontenerze nadpisują je zmienne środowiskowe (Dockerfile, compose.yaml),
# a APP_SECRET jest generowany przy pierwszym starcie i trzymany w wolumenie (/data/.app_secret).
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=change-me
APP_TIMEZONE=Europe/Warsaw
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
