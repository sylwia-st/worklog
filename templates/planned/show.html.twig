{% extends 'base.html.twig' %}

{% block title %}{{ change.typeLabel }} {{ change.date|date('d.m.Y') }} – Raport czasu{% endblock %}

{% block body %}
<p><a href="{{ path('planned') }}">← Planowane zmiany</a></p>
<h1>{{ change.typeLabel }}: {{ change.date|pl_day }}, {{ change.date|date('d.m.Y') }}</h1>
<p class="sub">
    {% if change.fromTime %}od {{ change.fromTime }} {% endif %}{% if change.toTime %}do {{ change.toTime }}{% endif %}
    {% if change.reason %} · {{ change.reason }}{% endif %}
</p>

{% if noticeHours < 0 %}
    <div class="flash error">Ten dzień już minął lub trwa – mail będzie wysłany po czasie.</div>
{% elseif noticeHours < requiredNotice %}
    <div class="flash warning">Uwaga: wymagane wyprzedzenie to {{ requiredNotice }} h, a zostało ok. {{ noticeHours|round(0, 'floor') }} h.</div>
{% endif %}

<div class="panel" style="max-width:720px">
    <h2>Mail</h2>
    {% if mail.invalid %}<p class="flash warning small">Pominięto niepoprawne adresy: {{ mail.invalid|join(', ') }}</p>{% endif %}
    {% if not mail.hasRecipients %}
        <p class="flash warning small">Brak adresatów – uzupełnij je w <a href="{{ path('settings') }}">Ustawieniach</a> (sekcja „zaplanowana zmiana”).</p>
    {% endif %}
    <div class="mailmeta">
        <span>Do</span><span>{{ mail.to|join(', ') ?: '—' }}</span>
        {% if mail.cc %}<span>DW</span><span>{{ mail.cc|join(', ') }}</span>{% endif %}
        <span>Temat</span><span>{{ mail.subject }}</span>
    </div>
    <pre id="mail-body">{{ mail.body }}</pre>
    <div class="actions">
        <a class="btn primary" href="{{ mail.mailtoUrl }}" data-mark="{{ path('planned_mark', {id: change.id}) }}" data-mark-label="#mail-status">Otwórz w programie pocztowym</a>
        <button type="button" data-copy="#mail-body">Kopiuj treść</button>
        {% if change.mailDoneAt %}<span id="mail-status" class="badge ok">✓ otwarto {{ change.mailDoneAt|date('d.m H:i') }}</span>
        {% else %}<span id="mail-status" class="badge warn">do wysłania</span>
            <button type="button" class="link" data-mark="{{ path('planned_mark', {id: change.id}) }}" data-mark-label="#mail-status" data-mark-hide
                title="Gdy mail poszedł inaczej, np. przez „Kopiuj treść” – przestanie się pojawiać w przypomnieniu">Wysłany</button>{% endif %}
    </div>
</div>

<form method="post" action="{{ path('planned_delete', {id: change.id}) }}" onsubmit="return confirm('Usunąć tę zmianę?')">
    <button type="submit" class="link">Usuń tę zmianę</button>
</form>
{% endblock %}
