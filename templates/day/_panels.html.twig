{% import '_icons.html.twig' as icons %}
{# Prawa kolumna dnia – renderowana w show.html.twig i odświeżana po autozapisie (GET /day/{date}/panels, razem z _live). #}
<section class="panel" id="balance-panel">
    {% if summary is null or summary.kind == 'empty' %}
        <div class="panel-h"><h2>{{ icons.i('balance') }}Bilans</h2></div>
        <p class="muted" style="margin:0">Pojawi się po wpisaniu godzin albo czasu w ticketach.</p>
    {% else %}
        {% set diff = summary.difference %}
        {% set kind = summary.kind == 'over' ? 'over' : (summary.kind == 'under' ? 'under' : 'okc') %}
        <div class="panel-h">
            <h2>{{ icons.i('balance') }}Bilans</h2>
            <span class="badge {{ summary.kind == 'over' ? 'warn' : (summary.kind == 'under' ? '' : 'ok') }}">{{ summary.kind == 'over' ? 'nadgodziny' : (summary.kind == 'under' ? 'krótszy dzień' : 'w normie') }}</span>
        </div>
        <div class="bignum">
            <span class="big {{ kind }}">{{ diff == 0 ? '±0' : diff|signed_hm }}</span>
            <span class="muted small">{{ diff == 0 ? 'równo z normą' : (diff > 0 ? 'ponad normę ' : 'poniżej normy ') ~ (diff != 0 ? summary.normMinutes|hm) }}</span>
        </div>
        {# pasek: obecność (albo czas w ticketach) względem normy, na tej samej skali co oś dnia #}
        {% set scale = axis.stack.scale %}
        {% set basis = summary.basisMinutes %}
        {% set norm = summary.normMinutes %}
        <div class="meter" role="img" aria-label="{{ summary.basedOnPresence ? 'Obecność' : 'Czas w ticketach' }} {{ basis|hm }} przy normie {{ norm|hm }}">
            <div class="fill" style="width:{{ (min(basis, norm) / scale * 100)|round(2) }}%"></div>
            {% if basis > norm %}<div class="extra" style="left:{{ (norm / scale * 100)|round(2) }}%; width:{{ ((basis - norm) / scale * 100)|round(2) }}%"></div>{% endif %}
            {% if norm > 0 %}<div class="norm" style="left:{{ (norm / scale * 100)|round(2) }}%"></div>{% endif %}
        </div>
        <p class="muted small" style="margin:6px 0 14px">
            Liczone z {{ summary.basedOnPresence ? 'godzin obecności' : (summary.balanceFromTickets ? 'czasu w ticketach' : 'czasu w ticketach (brak godzin od–do)') }}.
        </p>
        <dl class="stats">
            <dt>Obecność</dt><dd>{{ summary.presenceMinutes|hm }}</dd>
            {% if summary.presenceMinutes is not null %}<dt>Odliczona przerwa{{ day.workedThroughFixedBreak ? ' (wzięta później)' }}</dt><dd>{{ summary.breakMinutes|hm }}</dd>{% endif %}
            <dt>W ticketach</dt><dd>{{ summary.loggedMinutes|hm }}</dd>
            <dt>Norma</dt><dd>{{ summary.normMinutes|hm }}</dd>
        </dl>
        {% set gap = summary.loggedVsPresence %}
        {% if gap is not null and gap != 0 %}
            <p class="flash warning small" style="margin:14px 0 0">
                W ticketach jest {{ gap > 0 ? 'więcej' : 'mniej' }} niż czas obecności o {{ (gap|abs)|hm }}.
            </p>
        {% endif %}
    {% endif %}
</section>

<section class="panel" id="slack-panel">
    <div class="panel-h">
        <h2>{{ icons.i('slack') }}Slack</h2>
        {% if slack is not null %}
            {% if day.slackDoneAt %}<span id="slack-status" class="badge ok">✓ skopiowano {{ day.slackDoneAt|date('H:i') }}</span>
            {% else %}<span id="slack-status" class="badge">jeszcze nie</span>{% endif %}
        {% endif %}
    </div>
    {% if slack is null %}
        <p class="muted" style="margin:0">Pojawi się, gdy wpisy będą miały czas.</p>
    {% else %}
        <textarea id="slack-text" class="mono" rows="{{ min(12, (slack|split("\n")|length) + 1) }}" readonly>{{ slack }}</textarea>
        <div class="actions">
            <button type="button" class="primary" data-copy="#slack-text" data-mark="{{ path('day_mark', {date: date|date('Y-m-d'), what: 'slack'}) }}" data-mark-label="#slack-status">
                {{ icons.i('copy') }}Kopiuj na Slacka</button>
        </div>
    {% endif %}
</section>

{% if mail %}
<section class="panel" id="mail-panel">
    <div class="panel-h">
        <h2>{{ icons.i('mail') }}Mail: {{ summary.kind == 'over' ? 'nadgodziny' : 'krótszy dzień' }}</h2>
        {% if day.mailDoneAt %}<span id="mail-status" class="badge ok">✓ otwarto {{ day.mailDoneAt|date('H:i') }}</span>
        {% else %}<span id="mail-status" class="badge warn">do wysłania</span>{% endif %}
    </div>
    {% if not mail.hasRecipients %}
        <p class="flash warning small">Brak adresatów – uzupełnij je w <a href="{{ path('settings') }}">Ustawieniach</a>.</p>
    {% endif %}
    <div class="mailmeta">
        <span>Do</span><span>{{ mail.to|join(', ') ?: '—' }}</span>
        {% if mail.cc %}<span>DW</span><span>{{ mail.cc|join(', ') }}</span>{% endif %}
        <span>Temat</span><span id="mail-subject">{{ mail.subject }}</span>
    </div>
    <pre id="mail-body">{{ mail.body }}</pre>
    <div class="actions">
        <a class="btn primary" href="{{ mail.mailtoUrl }}" data-mailto-short="{{ mail.mailtoUrl(false) }}" data-mail-body="#mail-body" data-mark="{{ path('day_mark', {date: date|date('Y-m-d'), what: 'mail'}) }}" data-mark-label="#mail-status">
            {{ icons.i('mail') }}Otwórz w programie pocztowym</a>
        <button type="button" data-copy="#mail-body">Kopiuj treść</button>
        {% if not day.mailDoneAt %}
            <button type="button" class="link" data-mark="{{ path('day_mark', {date: date|date('Y-m-d'), what: 'mail'}) }}" data-mark-label="#mail-status" data-mark-hide
                title="Gdy mail poszedł inaczej, np. przez „Kopiuj treść” – przestanie się pojawiać w przypomnieniu">Wysłany</button>
        {% endif %}
    </div>
</section>
{% endif %}
