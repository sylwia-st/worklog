{% extends 'base.html.twig' %}

{% block title %}{{ date|date('d.m.Y') }} – Raport czasu{% endblock %}

{% import '_icons.html.twig' as icons %}
{% block body %}
<div class="dayhead">
    <div>
        <div class="daynav">
            <a class="btn iconbtn" href="{{ path('day', {date: prev|date('Y-m-d')}) }}" title="{{ prev|pl_day|capitalize }} {{ prev|date('d.m') }}" aria-label="Poprzedni dzień"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M10 3 5 8l5 5"/></svg></a>
            <input type="date" value="{{ date|date('Y-m-d') }}" aria-label="Wybierz dzień" onchange="location.href='{{ path('day', {date: '0000-00-00'})|replace({'0000-00-00': ''}) }}' + this.value">
            <a class="btn iconbtn" href="{{ path('day', {date: next|date('Y-m-d')}) }}" title="{{ next|pl_day|capitalize }} {{ next|date('d.m') }}" aria-label="Następny dzień"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 3 5 5-5 5"/></svg></a>
            {% if date == today %}<span class="pill-today">dziś</span>{% else %}<a class="pill-today" href="{{ path('today') }}">wróć do dziś</a>{% endif %}
        </div>
        <h1>{{ date|pl_day|capitalize }} <span class="soft">{{ date|pl_date }}</span></h1>
    </div>
    {{ include('day/_closing.html.twig') }}
</div>

{% if dayOff and dayOff.kind != 'weekend' %}
    <div class="flash info">
        <strong>{{ dayOff.kind == 'holiday' ? 'Święto: ' }}{{ dayOff.label }}</strong>{% if dayOff.absence %} ({{ dayOff.absence.rangeLabel }}){% endif %}.
        Raport nie jest potrzebny; praca w ten dzień liczy się w całości jako nadgodziny.
        {% if dayOff.absence %}<a href="{{ path('absences') }}">Zmień na stronie Wolne</a>{% endif %}
    </div>
{% elseif not dayOff and form.rows is empty %}
    {# jeden klik: ten dzień jako urlop / L4 / wolne – wraca tutaj #}
    <form method="post" action="{{ path('absence_add') }}" class="day-off muted small" style="margin:0 0 16px">
        <input type="hidden" name="from" value="{{ date|date('Y-m-d') }}">
        <input type="hidden" name="back" value="{{ path('day', {date: date|date('Y-m-d')}) }}">
        Nie pracujesz tego dnia? Oznacz go jako
        <button type="submit" name="type" value="urlop" class="link">urlop</button> ·
        <button type="submit" name="type" value="l4" class="link">L4</button> ·
        <button type="submit" name="type" value="wolne" class="link">dzień wolny</button>
    </form>
{% endif %}

{# wpisy odrzucone przez Jirę – baner zostaje, dopóki ponowna wysyłka się nie uda (treść błędu prosto od Jiry) #}
{% set jiraFailed = form.rows|filter(r => r.status == 'error') %}
{% if jiraFailed is not empty %}
    <div class="flash error jira-failed" role="alert">
        <strong>Jira nie przyjęła {{ plural(jiraFailed|length, 'wpisu', 'wpisów', 'wpisów') }} – tego czasu nie ma w Jirze.</strong>
        <ul>
            {% for r in jiraFailed %}<li><b>{{ r.issue }}</b>{{ r.time ? ' (' ~ r.time ~ ')' }}: {{ r.error }}</li>{% endfor %}
        </ul>
        <button type="submit" form="dayform" name="action" value="sync" class="primary">Wyślij ponownie do Jiry</button>
    </div>
{% endif %}

<div id="draft-banner" class="flash warning" hidden>
    <span id="draft-msg"></span>
    <button type="button" id="draft-restore" class="primary" style="margin-left:8px">Przywróć</button>
    <button type="button" id="draft-discard">Odrzuć</button>
</div>

{% for p in planned %}
    <div class="flash warning">
        Zaplanowana zmiana: <strong>{{ p.typeLabel }}</strong>
        {% if p.fromTime %} od {{ p.fromTime }}{% endif %}{% if p.toTime %} do {{ p.toTime }}{% endif %}
        – <a href="{{ path('planned_show', {id: p.id}) }}">{{ p.mailDoneAt ? 'szczegóły' : 'mail jeszcze niewysłany – otwórz' }}</a>
    </div>
{% endfor %}
{% if unsentPlanned is not empty %}
    <div class="flash warning">
        {{ unsentPlanned|length == 1 ? 'Czeka mail o planowanej zmianie:' : 'Czekają maile o planowanych zmianach:' }}
        {% for p in unsentPlanned %}
            <a href="{{ path('planned_show', {id: p.id}) }}"><strong>{{ rel_day(p.date) }}</strong> – {{ p.typeLabel|lower }}</a>{{ not loop.last ? ' · ' }}
        {% endfor %}
        <span class="muted small">(kliknij, żeby otworzyć mail; wysłany inaczej oznacz tam przyciskiem „Wysłany”)</span>
    </div>
{% endif %}

{{ include('day/_axis.html.twig') }}

<div class="grid daygrid">
<div>
    {% if togglConfigured %}<form id="togglform" method="post" action="{{ path('day_toggl', {date: date|date('Y-m-d')}) }}"></form>{% endif %}
    <form method="post" action="{{ path('day_save', {date: date|date('Y-m-d')}) }}" class="panel dayform" id="dayform">
        <div class="hours">
            <div class="hfield"><label for="start" class="lbl">Od</label><input type="time" id="start" name="start" value="{{ form.start }}"></div>
            <div class="hfield"><label for="end" class="lbl">Do</label><input type="time" id="end" name="end" value="{{ form.end }}"></div>
            <div class="hfield wide"><label for="break" id="break-label" class="lbl">{{ lunch and form.lunchWorked ? 'Przerwa wzięta (łącznie)' : 'Dodatkowa przerwa' }}</label><input type="text" id="break" name="break" value="{{ form.break }}" placeholder="np. 30m · 20m + 40m · 13:30-13:50"></div>
        </div>
        {% if lunch %}
            {% set helpOn = 'Obiad nie jest odliczany automatycznie. W „Przerwa wzięta” wpisz, ile przerwy faktycznie ' ~ forma('wzięłaś', 'wziąłeś', 'było') ~ ' – samym czasem (20m + 40m) albo godzinami (13:30-13:50, 15:00-15:40). ' ~ forma('Jeśli nie wzięłaś wcale', 'Jeśli nie wziąłeś wcale', 'Jeśli nie było jej wcale') ~ ' – wpisz 0.' %}
            {% set helpOff = 'Przerwa ' ~ lunch ~ ' odlicza się sama (' ~ forma('jeśli byłaś wtedy w pracy', 'jeśli byłeś wtedy w pracy', 'jeśli wypada w godzinach pracy') ~ '). „Dodatkowa przerwa” – tylko gdy była jeszcze jakaś inna.' %}
            <label class="lunchchk">
                <input type="checkbox" id="lunch_worked" name="lunch_worked" value="1" {{ form.lunchWorked ? 'checked' }} data-lunch="{{ lunchLength }}" data-help-on="{{ helpOn }}" data-help-off="{{ helpOff }}" style="margin-top:4px">
                <span>{{ forma('Pracowałam', 'Pracowałem', 'Praca') }} w przerwie obiadowej {{ lunch }} (awaria / pilna sprawa)</span>
            </label>
            <p class="muted small" id="lunch-help">
                {{ form.lunchWorked ? helpOn : helpOff }}
            </p>
        {% endif %}

        <div class="panel-h entries-h"><h2>{{ icons.i('timer') }}Czas w ticketach</h2></div>
        <table class="entries">
            <colgroup><col class="c-st"><col class="c-issue"><col><col class="c-fromto"><col class="c-time"><col class="c-tm"><col class="c-del"></colgroup>
            <thead><tr><th><span class="vh">Stan w Jirze</span></th><th>Ticket</th><th title="Komentarz worklogu w Jirze i opis na Slacku">Opis</th><th>Od–do</th><th class="r">Czas</th><th><span class="vh">Stoper</span></th><th><span class="vh">Usuń</span></th></tr></thead>
            <tbody id="rows" data-lunch="{{ lunch }}">
            {% for row in form.rows %}
                {{ _self.entry_row(loop.index0, row, issueOptions) }}
            {% endfor %}
            </tbody>
        </table>
        <div id="startat" class="flash info" hidden style="margin-top:8px">
            <label for="startat-time" style="display:inline; color:inherit">Stoper dla <b id="startat-issue"></b> od godziny</label>
            <input type="time" id="startat-time">
            <button type="button" id="startat-go" class="primary">Włącz od tej godziny</button>
            <button type="button" id="startat-cancel">Anuluj</button>
        </div>
        <div class="addrow">
            <button type="button" id="addrow" class="link">{{ icons.i('plus') }}Dodaj wpis</button>
            {% if form.rows is empty %}
                <a class="small" href="{{ path('day', {date: date|date('Y-m-d'), copy: 1}) }}">skopiuj tickety z poprzedniego dnia</a>
            {% endif %}
            {% if togglConfigured %}
                <button type="submit" form="togglform" class="link" title="Wpisy z tym samym ticketem i opisem łączą się w jeden wiersz, a ponowne pobranie aktualizuje czas zamiast dublować wiersze.">{{ icons.i('toggl') }}Pobierz z Toggla</button>
                {% if day and day.togglSyncedAt %}
                    {% set togglRows = day.activeEntries|filter(e => e.togglIds is not empty)|length %}
                    <span class="muted small">pobrano o {{ day.togglSyncedAt|date('H:i') }} · {{ plural(togglRows, 'wiersz', 'wiersze', 'wierszy') }} z Toggla</span>
                {% endif %}
            {% endif %}
            <span class="hint">Czas: 1h 30m · 1.5 · 90m · 1:30 (sama liczba to godziny, najwyżej 12) – albo ▶ stoper. Od–do niewymagane: start + czas albo start + koniec.</span>
        </div>

        {% if pendingDeletions is not empty %}
            <div class="flash warning small" style="margin-top:14px">
                Przy najbliższej wysyłce zostaną usunięte z Jiry:
                {% for e in pendingDeletions %}<strong>{{ e.jiraIssueKey }}</strong> ({{ e.minutes|hm }}){{ not loop.last ? ', ' }}{% endfor %}
            </div>
        {% endif %}

        <p class="legend">
            <span><i class="dot synced"></i>w Jirze</span><span><i class="dot changed"></i>zmieniony – wyślij ponownie</span>
            <span><i class="dot new"></i>nowy</span><span><i class="dot error"></i>błąd</span>
            <span>Usunięcie (✕) trzeba potwierdzić po kliknięciu „Zapisz”.</span>
        </p>

        <div class="savebar">
            <span id="savestate" class="badge" aria-live="polite">{{ day ? 'zapisane' : 'nic jeszcze nie zapisano' }}</span>
            <button type="submit" name="action" value="save">Zapisz</button>
            <button type="submit" name="action" value="sync" class="primary" id="syncbtn">{{ icons.i('send') }}Zapisz i wyślij do Jiry</button>
        </div>
        {# Za przyciskami „Zapisz” – żeby Enter w polu (domyślny przycisk formularza) nigdy nie potwierdzał usunięcia. #}
        <div id="delconfirm" class="flash warning" {{ confirmDelete ? '' : 'hidden' }} style="margin-top:12px">
            <p style="margin:0 0 6px"><strong>Usunąć zaznaczone wpisy?</strong> Jeśli wpis jest już w Jirze, zostanie z niej usunięty przy wysyłce.</p>
            <ul id="delconfirm-list" style="margin:0 0 10px; padding-left:20px">
                {% for r in confirmDelete ? confirmDelete.rows : [] %}<li>{{ [r.issue, r.time, r.desc]|filter(v => v)|join(' – ') }}</li>{% endfor %}
            </ul>
            <button type="submit" name="confirm_delete" value="{{ confirmDelete ? confirmDelete.action : 'save' }}" id="delconfirm-go" class="danger">Usuń zaznaczone</button>
            <button type="button" id="delconfirm-cancel">Anuluj</button>
        </div>
    </form>
</div>

<div id="panels">
    {{ include('day/_panels.html.twig') }}
</div>
</div>

<datalist id="issues">
    {% for key, title in issueOptions %}<option value="{{ key }}">{{ key }}{{ title ? ' – ' ~ title }}</option>{% endfor %}
</datalist>

<template id="rowtpl">{{ _self.entry_row('__i__', {id: 0, issue: '', title: '', from: '', to: '', time: '', desc: '', status: null, error: null}, {}) }}</template>
{% endblock %}

{% macro entry_row(i, row, titles) %}
    {% import '_icons.html.twig' as icons %}
    <tr class="{{ row.error and row.status != 'error' ? 'has-error' }}{{ row.delete|default(false) ? ' marked-delete' }}" data-key="{{ i }}">
        <td class="st">
            {% set stTitles = {synced: 'Wysłane do Jiry', changed: 'Zmienione – wyślij ponownie', new: 'Jeszcze nie w Jirze', empty: 'Brak czasu – nie będzie wysłane', error: 'Błąd: ' ~ row.error} %}
            <span class="dot {{ row.status ?: 'none' }}" title="{{ row.status ? stTitles[row.status] : '' }}"></span>
        </td>
        <td class="issue">
            {% if row.toggl|default(false) %}<span class="from-toggl" title="Pobrany z Toggla">{{ icons.i('toggl', 12) }}</span>{% endif %}
            <input type="hidden" name="entries[{{ i }}][id]" value="{{ row.id }}" class="f-id">
            <input type="hidden" name="entries[{{ i }}][orig]" value="{{ row.time }}" class="f-orig">
            <input type="text" name="entries[{{ i }}][issue]" value="{{ row.issue }}" list="issues" placeholder="ABC-123" autocomplete="off" class="f-issue" aria-label="Ticket">
            <input type="text" name="entries[{{ i }}][title]" value="{{ row.title|default('') }}" placeholder="{{ titles[row.issue]|default('') ?: 'tytuł' }}" autocomplete="off" class="f-title" aria-label="Tytuł ticketu" title="Tytuł ticketu – na Slacka, do maila i do eksportu CSV">
        </td>
        <td class="desc">
            <textarea name="entries[{{ i }}][desc]" rows="1" placeholder="Co zostało zrobione" class="f-desc" aria-label="Opis">{{ row.desc }}</textarea>
            <div class="rowerr">{% if row.error %}{{ row.status == 'error' ? 'Jira: ' }}{{ row.error }}{% endif %}</div>
        </td>
        <td class="fromto">
            <input type="text" name="entries[{{ i }}][from]" value="{{ row.from|default('') }}" placeholder="od" inputmode="numeric" autocomplete="off" class="f-from" aria-label="Godzina rozpoczęcia" title="Godzina rozpoczęcia – worklog w Jirze zacznie się dokładnie o niej">
            <span aria-hidden="true">–</span>
            <input type="text" name="entries[{{ i }}][to]" value="{{ row.to|default('') }}" placeholder="do" inputmode="numeric" autocomplete="off" class="f-to" aria-label="Godzina zakończenia" title="Godzina zakończenia – czas wyliczy się sam">
        </td>
        <td class="time">
            <input type="text" name="entries[{{ i }}][time]" value="{{ row.time }}" placeholder="1h 30m" class="f-time" aria-label="Czas">
            <div class="live"></div>
        </td>
        <td class="tm"><button type="button" class="tbtn" title="Włącz stoper">▶</button><button type="button" class="tfrom" title="Włącz stoper od wcześniejszej godziny">od…</button></td>
        <td class="del">
            <label class="delbox" title="Usuń wpis{{ row.status ? ' (także z Jiry)' }} – po kliknięciu Zapisz aplikacja poprosi o potwierdzenie">
                <input type="checkbox" name="entries[{{ i }}][delete]" value="1" class="f-del" {{ row.delete|default(false) ? 'checked' }} aria-label="Usuń wpis">
                <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m3.5 3.5 7 7m0-7-7 7"/></svg>
            </label>
        </td>
    </tr>
{% endmacro %}

{% block scripts %}
<script>
(() => {
    const DATE = '{{ date|date('Y-m-d') }}';
    const AUTOSAVE_URL = '{{ path('day_autosave', {date: date|date('Y-m-d')}) }}';
    const PANELS_URL = '{{ path('day_panels', {date: date|date('Y-m-d')}) }}';
    const DRAFT_KEY = 'worklog-draft-' + DATE;
    const form = document.getElementById('dayform');
    const rows = document.getElementById('rows');
    const tpl = document.getElementById('rowtpl').innerHTML;
    const stateEl = document.getElementById('savestate');
    let next = rows.children.length;

    // ---------- wiersze ----------
    const add = (focus = true) => {
        rows.insertAdjacentHTML('beforeend', tpl.replaceAll('__i__', next++));
        if (focus) rows.lastElementChild.querySelector('.f-issue').focus();
        return rows.lastElementChild;
    };
    document.getElementById('addrow').addEventListener('click', () => add());
    if (rows.children.length === 0) { add(false); add(false); add(false); }
    rows.addEventListener('keydown', (ev) => {
        if (ev.key === 'Enter' && ev.target.tagName === 'INPUT' && ev.target.closest('tr') === rows.lastElementChild) {
            ev.preventDefault(); add();
        }
    });
    const val = (tr, sel) => { const el = tr.querySelector(sel); return el ? el.value.trim() : ''; };
    const rowById = (id) => [...rows.children].find(tr => tr.querySelector('.f-id').value === String(id));
    const rowByKey = (key) => rows.querySelector(`tr[data-key="${key}"]`);

    // ---------- autozapis ----------
    // dirty – licznik zmian, savedDirty – stan licznika przy ostatnim udanym zapisie
    let dirty = 0, savedDirty = 0, saving = false, submitting = false, retryTimer = null, debounce = null;
    const setState = (cls, text) => { stateEl.className = 'badge ' + cls; stateEl.textContent = text; };
    const formData = () => { const fd = new FormData(form); fd.delete('action'); return fd; };

    // treść formularza bez technicznych pól (id, orig) – do porównania szkicu z tym, co jest w bazie
    const content = () => {
        const fd = formData(), out = {day: [fd.get('start'), fd.get('end'), fd.get('break'), fd.get('lunch_worked') || ''], rows: []};
        for (const tr of rows.children) {
            if (tr.querySelector('.f-del').checked) continue;
            const issue = tr.querySelector('.f-issue').value.trim(), time = tr.querySelector('.f-time').value.trim(), desc = tr.querySelector('.f-desc').value.trim();
            const from = val(tr, '.f-from'), to = val(tr, '.f-to'), title = val(tr, '.f-title');
            if (issue || time || desc || from || to || title) out.rows.push([issue, title, from, to, time, desc]);
        }
        return JSON.stringify(out);
    };
    const serverContent = content();

    const writeDraft = () => {
        try { localStorage.setItem(DRAFT_KEY, JSON.stringify({at: Date.now(), content: content(), fields: [...formData().entries()]})); } catch (e) {}
    };
    const clearDraft = () => { try { localStorage.removeItem(DRAFT_KEY); } catch (e) {} };

    const changed = () => {
        dirty++;
        writeDraft();
        setState('', 'zapisywanie…');
        clearTimeout(debounce);
        debounce = setTimeout(save, 900);
    };
    form.addEventListener('input', changed);
    form.addEventListener('change', (ev) => { if (!ev.target.classList.contains('f-del')) changed(); });

    async function save() {
        clearTimeout(debounce); clearTimeout(retryTimer);
        if (submitting) return;
        if (saving) { debounce = setTimeout(save, 400); return; }
        const sentAt = dirty;
        saving = true;
        try {
            const res = await fetch(AUTOSAVE_URL, {method: 'POST', body: formData(), credentials: 'same-origin'});
            if (!res.ok) throw new Error('HTTP ' + res.status);
            applyResult(await res.json());
            savedDirty = sentAt;
            if (dirty === sentAt) { clearDraft(); } else if (!submitting) { writeDraft(); debounce = setTimeout(save, 400); }
            refreshPanels();
        } catch (e) {
            setState('err', '⚠ nie udało się zapisać – zmiany są bezpieczne w przeglądarce, ponawiam…');
            retryTimer = setTimeout(save, 10000);
        } finally {
            saving = false;
        }
        return true;
    }
    window.WorklogDay = {save, rowById};

    function applyResult(r) {
        for (const [key, id] of Object.entries(r.ids || {})) {
            const tr = rowByKey(key); if (!tr) continue;
            tr.querySelector('.f-id').value = id;
            const time = tr.querySelector('.f-time');
            const serverTime = fmt(r.minutes[key]);
            if (document.activeElement !== time && !tr.classList.contains('running')) time.value = serverTime;
            tr.querySelector('.f-orig').value = serverTime;
            const to = tr.querySelector('.f-to');
            if (to && document.activeElement !== to && r.ends && key in r.ends) to.value = r.ends[key];
        }
        for (const tr of rows.children) {
            const key = tr.dataset.key, err = (r.rowErrors || {})[key];
            tr.classList.toggle('has-error', !!err);
            const box = tr.querySelector('.rowerr');
            if (err) box.textContent = err; else if (!box.textContent.startsWith('Jira:')) box.textContent = '';
            const st = (r.statuses || {})[tr.querySelector('.f-id').value];
            const dot = tr.querySelector('.dot');
            if (st) dot.className = 'dot ' + st;
        }
        const errs = (r.dayErrors || []);
        if (errs.length) setState('warn', '⚠ ' + errs.join(' '));
        else if (Object.keys(r.rowErrors || {}).length) setState('warn', '⚠ zapisano, oprócz zaznaczonych wierszy (' + r.savedAt + ')');
        else setState('ok', '✓ zapisano ' + r.savedAt);
    }

    async function refreshPanels() {
        try {
            const res = await fetch(PANELS_URL, {credentials: 'same-origin'});
            if (!res.ok) return;
            const t = document.createElement('template');
            t.innerHTML = await res.text();
            for (const part of t.content.querySelectorAll('[data-part]')) {
                const old = document.getElementById(part.id);
                if (old) old.replaceWith(part); else part.remove();
            }
            document.getElementById('panels').replaceChildren(t.content);
            paintTickets();
        } catch (e) {}
    }

    // kolor ticketu z osi dnia (segmenty .seg[data-key]) – kropka przy numerze w wierszu
    function paintTickets() {
        const colors = {};
        for (const seg of document.querySelectorAll('#dayaxis .seg[data-key]')) colors[seg.dataset.key] = getComputedStyle(seg).getPropertyValue('--c').trim();
        for (const tr of rows.children) {
            const c = colors[val(tr, '.f-issue').toUpperCase()];
            if (c) tr.style.setProperty('--c', c); else tr.style.removeProperty('--c');
        }
    }
    paintTickets();

    // zamknięcie karty / przejście dalej – ostatnia próba zapisu
    const flush = () => { if (dirty !== savedDirty && !saving && !submitting) navigator.sendBeacon(AUTOSAVE_URL, formData()); };
    window.addEventListener('pagehide', flush);
    document.addEventListener('visibilitychange', () => { if (document.visibilityState === 'hidden') flush(); });
    // pełny zapis przyciskiem – szkic zostaje do czasu, aż strona wróci z serwera z tą samą treścią.
    // Autozapis nie może biec równolegle: nowy wiersz (id=0) zapisałby się wtedy dwa razy (i trafił dwa razy do Jiry).
    // Czekamy więc na trwający autozapis (jego id trafią do formularza), a potem blokujemy kolejne i beacon.
    // Właściwe wysłanie idzie przez requestSubmit dopiero po wyjściu z tej obsługi: wywołane w trakcie
    // zdarzenia submit przeglądarka po cichu ignoruje (wtedy „Zapisz” nic nie robiło).
    let resubmit = false;
    form.addEventListener('submit', async (ev) => {
        if (resubmit) return;
        ev.preventDefault();
        if (submitting) return; // drugie kliknięcie, zanim pierwsze poszło
        submitting = true;
        clearTimeout(debounce); clearTimeout(retryTimer);
        await new Promise(r => setTimeout(r));
        while (saving) await new Promise(r => setTimeout(r, 50));
        clearTimeout(debounce); clearTimeout(retryTimer);
        // usunięcie wierszy nigdy nie zapisuje się samo – najpierw lista do potwierdzenia
        if (ev.submitter !== delGo && markedRows().length) {
            submitting = false;
            showDelConfirm(ev.submitter && ev.submitter.value === 'sync' ? 'sync' : 'save');
            if (dirty !== savedDirty) debounce = setTimeout(save, 400);
            return;
        }
        resubmit = true;
        try { form.requestSubmit(ev.submitter); } finally { resubmit = false; }
    });
    // powrót przyciskiem Wstecz (strona z pamięci przeglądarki) – przyciski znowu działają
    window.addEventListener('pageshow', (ev) => { if (ev.persisted) submitting = false; });

    // „Pobierz z Toggla” to osobny formularz – najpierw czekamy na zapis dnia (jak przy submit #dayform), żeby import
    // nie ścigał się z autozapisem i nie zgubił niezapisanej edycji. Bez JS to zwykły submit.
    const togglForm = document.getElementById('togglform');
    let togglGo = false;
    window.addEventListener('pageshow', (ev) => { if (ev.persisted) togglGo = false; }); // powrót z pamięci przeglądarki
    if (togglForm) togglForm.addEventListener('submit', async (ev) => {
        if (togglGo) return;
        ev.preventDefault();
        clearTimeout(debounce); clearTimeout(retryTimer);
        while (saving) await new Promise(r => setTimeout(r, 50));
        if (dirty !== savedDirty) await save();
        if (dirty !== savedDirty) return; // zapis się nie udał – komunikat stoi przy przyciskach, nie importujemy na niezapisany dzień
        submitting = true; togglGo = true;
        await new Promise(r => setTimeout(r, 0)); // jw. – nie w trakcie dispatchu zdarzenia submit
        togglForm.requestSubmit();
    });

    // ---------- usuwanie wierszy: zawsze z potwierdzeniem ----------
    // Serwer też usuwa tylko z potwierdzeniem (confirm_delete), a autozapis nie usuwa nigdy.
    const delPanel = document.getElementById('delconfirm');
    const delGo = document.getElementById('delconfirm-go');
    const markedRows = () => [...rows.children].filter(tr => tr.querySelector('.f-del').checked && Number(tr.querySelector('.f-id').value) > 0);
    function showDelConfirm(action) {
        document.getElementById('delconfirm-list').replaceChildren(...markedRows().map(tr => {
            const li = document.createElement('li');
            li.textContent = [[val(tr, '.f-issue'), val(tr, '.f-title')].filter(Boolean).join(' '), val(tr, '.f-time'), val(tr, '.f-desc')].filter(Boolean).join(' – ');
            return li;
        }));
        delGo.value = action;
        delPanel.hidden = false;
        document.getElementById('delconfirm-cancel').focus();   // bezpieczny domyślny wybór
    }
    rows.addEventListener('change', (ev) => {
        if (!ev.target.classList.contains('f-del')) return;
        ev.target.closest('tr').classList.toggle('marked-delete', ev.target.checked);
        if (!delPanel.hidden) { if (markedRows().length) showDelConfirm(delGo.value); else delPanel.hidden = true; }
    });
    document.getElementById('delconfirm-cancel').addEventListener('click', () => { delPanel.hidden = true; });
    document.addEventListener('keydown', (ev) => {
        if ((ev.ctrlKey || ev.metaKey) && ev.key === 's') { ev.preventDefault(); save(); }
    });

    // ---------- szkic w przeglądarce ----------
    (() => {
        let draft = null;
        try { draft = JSON.parse(localStorage.getItem(DRAFT_KEY) || 'null'); } catch (e) {}
        if (!draft) return;
        if (draft.content === serverContent) { clearDraft(); return; }
        const banner = document.getElementById('draft-banner');
        const when = new Date(draft.at);
        document.getElementById('draft-msg').textContent =
            'W przeglądarce są zmiany z ' + when.toLocaleString('pl-PL', {day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit'}) +
            ', których nie ma w bazie (np. karta zamknęła się przed zapisem).';
        banner.hidden = false;
        document.getElementById('draft-discard').onclick = () => { clearDraft(); banner.hidden = true; };
        document.getElementById('draft-restore').onclick = () => {
            const byKey = {};
            for (const [name, value] of draft.fields) {
                const m = name.match(/^entries\[([^\]]+)\]\[(\w+)\]$/);
                if (m) { (byKey[m[1]] ??= {})[m[2]] = value; continue; }
                const el = form.elements[name];
                if (el && el.type === 'checkbox') el.checked = true; else if (el) el.value = value;
            }
            if (!draft.fields.some(([n]) => n === 'lunch_worked') && form.elements['lunch_worked']) form.elements['lunch_worked'].checked = false;
            rows.innerHTML = '';
            next = 0;
            for (const f of Object.values(byKey)) {
                const tr = add(false);
                tr.querySelector('.f-id').value = f.id || 0;
                tr.querySelector('.f-orig').value = f.orig || '';
                tr.querySelector('.f-issue').value = f.issue || '';
                tr.querySelector('.f-time').value = f.time || '';
                tr.querySelector('.f-desc').value = f.desc || '';
                if (tr.querySelector('.f-title')) tr.querySelector('.f-title').value = f.title || '';
                if (tr.querySelector('.f-from')) { tr.querySelector('.f-from').value = f.from || ''; tr.querySelector('.f-to').value = f.to || ''; }
            }
            if (!rows.children.length) add(false);
            banner.hidden = true;
            changed();
        };
    })();

    // ---------- stoper ----------
    const fmt = (m) => { m = Number(m) || 0; if (!m) return ''; const h = Math.floor(m / 60), r = m % 60; return h ? (r ? `${h}h ${r}m` : `${h}h`) : `${r}m`; };
    const clock = (s) => { const h = Math.floor(s / 3600), m = Math.floor(s % 3600 / 60), x = s % 60; return `${h}:${String(m).padStart(2, '0')}:${String(x).padStart(2, '0')}`; };

    // Zapisuje wiersz (jeśli trzeba) i włącza przy nim stoper – teraz albo od podanej godziny ('YYYY-MM-DDTHH:MM').
    async function startRow(tr, btn, at) {
        if (!tr.querySelector('.f-issue').value.trim()) { alert('Najpierw wpisz numer ticketu.'); tr.querySelector('.f-issue').focus(); return false; }
        btn.disabled = true;
        if (dirty || tr.querySelector('.f-id').value === '0') { await save(); }
        btn.disabled = false;
        const id = tr.querySelector('.f-id').value;
        if (!id || id === '0') { alert('Nie udało się zapisać wiersza – sprawdź numer ticketu i czas.'); return false; }
        await window.WorklogTimer.start(Number(id), at);
        return true;
    }

    rows.addEventListener('click', async (ev) => {
        const btn = ev.target.closest('.tbtn'); if (!btn) return;
        const tr = btn.closest('tr');
        if (tr.classList.contains('running')) { await window.WorklogTimer.stop(); return; }
        await startRow(tr, btn);
    });

    // „od…” – stoper od wcześniejszej godziny (zaczęło się zadanie, a ▶ nie zostało kliknięte od razu)
    const startAt = document.getElementById('startat');
    let startAtRow = null;
    rows.addEventListener('click', (ev) => {
        const btn = ev.target.closest('.tfrom'); if (!btn) return;
        startAtRow = btn.closest('tr');
        const now = new Date();
        document.getElementById('startat-issue').textContent = startAtRow.querySelector('.f-issue').value.trim() || 'tego wiersza';
        document.getElementById('startat-time').value = String(now.getHours()).padStart(2, '0') + ':' + String(now.getMinutes()).padStart(2, '0');
        startAt.hidden = false;
        document.getElementById('startat-time').focus();
    });
    document.getElementById('startat-cancel').onclick = () => { startAt.hidden = true; startAtRow = null; };
    document.getElementById('startat-go').onclick = async (ev) => {
        const time = document.getElementById('startat-time').value;
        if (!startAtRow || !time) return;
        if (await startRow(startAtRow, ev.target, DATE + 'T' + time).catch(() => false)) { startAt.hidden = true; startAtRow = null; }
    };

    const STOPPED_HINT = 'Stoper działa – zatrzymaj go, żeby wpisać godzinę', TO_HINT = 'Godzina zakończenia – czas wyliczy się sam';
    document.addEventListener('timer:update', (ev) => {
        const s = ev.detail;
        for (const tr of rows.children) {
            const on = s.running && s.date === DATE && tr.querySelector('.f-id').value === String(s.entryId);
            tr.classList.toggle('running', on);
            tr.querySelector('.tbtn').textContent = on ? '❚❚' : '▶';
            tr.querySelector('.tbtn').title = on ? 'Zatrzymaj stoper' : 'Włącz stoper';
            const time = tr.querySelector('.f-time'), to = tr.querySelector('.f-to');
            time.readOnly = on;
            time.title = on ? STOPPED_HINT : '';
            if (to) { to.readOnly = on; to.title = on ? STOPPED_HINT : TO_HINT; }
            if (!on) tr.querySelector('.live').textContent = '';
        }
        if (s.stopped && s.stopped.date === DATE) {
            const tr = rowById(s.stopped.entryId);
            if (tr) {
                tr.querySelector('.f-time').value = fmt(s.stopped.minutes);
                tr.querySelector('.f-orig').value = fmt(s.stopped.minutes);
                fillHours(tr, 'time');
                refreshPanels();
            }
        }
    });
    document.addEventListener('timer:tick', (ev) => {
        const s = ev.detail; if (!s.running || s.date !== DATE) return;
        const tr = rowById(s.entryId);
        if (tr) tr.querySelector('.live').textContent = '⏱ ' + clock(s.baseSeconds + s.elapsedNow);
    });

    // ---------- od–do: z godziny rozpoczęcia i czasu wylicza koniec, z rozpoczęcia i końca – czas ----------
    // Liczy tak jak serwer (TimeFormat::parse); przy czymś niejasnym nic nie zmienia, serwer i tak to oceni.
    const parseClock = (s) => { const m = String(s).trim().match(/^([01]?\d|2[0-3])[:.]([0-5]\d)$/); return m ? m[1] * 60 + Number(m[2]) : null; };
    const toClock = (m) => { m = ((m % 1440) + 1440) % 1440; return String(Math.floor(m / 60)).padStart(2, '0') + ':' + String(m % 60).padStart(2, '0'); };
    const parseDur = (raw) => {
        const s = String(raw).trim().toLowerCase().replace(',', '.');
        let m, min = null;
        if ((m = s.match(/^(\d{1,2}):([0-5]\d)$/))) min = m[1] * 60 + Number(m[2]);
        else if (/^\d+(\.\d+)?$/.test(s)) min = /^\d+$/.test(s) && Number(s) > 12 ? null : Math.round(parseFloat(s) * 60);
        else if ((m = s.match(/^(?:(\d+(?:\.\d+)?)\s*(?:h|g|godz\.?)\s*)?(?:(\d+)\s*(?:m|min\.?)?)?$/)) && (m[1] || m[2])) min = Math.round(parseFloat(m[1] || 0) * 60) + Number(m[2] || 0);
        return min > 0 && min <= 1440 ? min : null;
    };
    // Przerwy, które pomija czas między godzinami (jak DaySummary::breakWindows): obiad, chyba że zaznaczono
    // pracę w przerwie, i przerwy wpisane godzinami (13:30-13:50, 15:00-15:40).
    const breakWindows = () => {
        const out = [];
        const lunch = (rows.dataset.lunch || '').split('–').map(parseClock), lw = document.getElementById('lunch_worked');
        if (lunch.length === 2 && lunch[0] !== null && lunch[1] > lunch[0] && !(lw && lw.checked)) out.push(lunch);
        const brk = form.elements['break'];
        for (const part of (brk ? brk.value : '').split(/[,;+\n]/)) {
            const m = part.trim().match(/^(\d{1,2}[:.]\d{2})\s*[-–]\s*(\d{1,2}[:.]\d{2})$/);
            const a = m && parseClock(m[1]), b = m && parseClock(m[2]);
            if (m && a !== null && b !== null && b > a) out.push([a, b]);
        }
        out.sort((x, y) => x[0] - y[0]);
        return out.reduce((acc, r) => { const l = acc[acc.length - 1]; if (l && r[0] <= l[1]) l[1] = Math.max(l[1], r[1]); else acc.push([...r]); return acc; }, []);
    };
    // jak DaySummary::workedBetween i DaySummary::advance
    const workedBetween = (from, to, ws) => Math.max(0, ws.reduce((m, [a, b]) => m - Math.max(0, Math.min(to, b) - Math.max(from, a)), to - from));
    const advance = (from, minutes, ws) => {
        let cur = from;
        for (const [a, b] of ws) {
            if (b <= cur) continue;
            if (a >= cur + minutes) break;
            minutes -= Math.max(0, a - cur);
            cur = b;
        }
        return cur + minutes;
    };
    function fillHours(tr, changedField) {
        const fromEl = tr.querySelector('.f-from'), toEl = tr.querySelector('.f-to'), timeEl = tr.querySelector('.f-time');
        if (!fromEl) return;
        const from = parseClock(fromEl.value), to = parseClock(toEl.value), dur = parseDur(timeEl.value);
        if (from === null) { if (changedField === 'from' && fromEl.value.trim() === '') toEl.value = ''; return; }
        const ws = breakWindows();
        if (changedField === 'to' || (changedField === 'from' && dur === null)) {
            const worked = to !== null && to > from ? workedBetween(from, to, ws) : 0;
            if (worked > 0) timeEl.value = fmt(worked);
        } else if (dur !== null) {
            toEl.value = toClock(advance(from, dur, ws));
        } else if (changedField === 'time' && timeEl.value.trim() === '') {
            toEl.value = '';
        }
    }
    // zmiana przerw dnia przesuwa koniec wpisów z godziną rozpoczęcia (czas zostaje)
    const refillAll = (ev) => { if (ev.target.id === 'break' || ev.target.id === 'lunch_worked') for (const tr of rows.children) fillHours(tr, 'time'); };
    form.addEventListener('input', refillAll);
    form.addEventListener('change', refillAll);
    rows.addEventListener('input', (ev) => {
        const field = ev.target.classList.contains('f-from') ? 'from' : ev.target.classList.contains('f-to') ? 'to' : ev.target.classList.contains('f-time') ? 'time' : null;
        if (field) fillHours(ev.target.closest('tr'), field);
    });

    // ---------- tytuł ticketu pod numerem ----------
    // „ABC-123 Produkcja nie działa” wpisane (albo wklejone) w pole ticketu rozdziela się na numer i tytuł,
    // a przy znanym numerze tytuł podpowiada się sam (wpisany wcześniej albo z Jiry).
    const titles = Object.fromEntries([...document.querySelectorAll('#issues option')].map(o => [o.value, o.textContent.split(' – ').slice(1).join(' – ')]));
    rows.addEventListener('input', (ev) => {
        const tr = ev.target.closest('tr'), titleEl = tr && tr.querySelector('.f-title');
        if (!titleEl) return;
        if (ev.target === titleEl) { titleEl.dataset.auto = ''; return; }
        if (!ev.target.classList.contains('f-issue')) return;
        const m = ev.target.value.match(/^\s*([A-Za-z][A-Za-z0-9_]+-\d+)\s*[-–—:|]?\s+(\S[\s\S]*)$/);
        if (m) {
            ev.target.value = m[1].toUpperCase();
            titleEl.value = m[2];
            titleEl.dataset.auto = '';
            titleEl.focus();
            titleEl.setSelectionRange(titleEl.value.length, titleEl.value.length);
            return;
        }
        const known = titles[ev.target.value.trim().toUpperCase()] || '';
        titleEl.placeholder = known || 'tytuł';
        if (!titleEl.value.trim() || titleEl.dataset.auto === '1') {
            titleEl.value = known;
            titleEl.dataset.auto = known ? '1' : '';
        }
    });

    // ---------- przerwa obiadowa ----------
    const lw = document.getElementById('lunch_worked');
    if (lw) {
        const brk = document.getElementById('break'), lbl = document.getElementById('break-label'), help = document.getElementById('lunch-help');
        lw.addEventListener('change', () => {
            if (lw.checked) {
                lbl.textContent = 'Przerwa wzięta (łącznie)';
                if (brk.value.trim() === '') brk.value = lw.dataset.lunch;
                help.textContent = lw.dataset.helpOn;
                brk.focus(); brk.select();
            } else {
                lbl.textContent = 'Dodatkowa przerwa';
                if (brk.value.trim() === lw.dataset.lunch) brk.value = '';
                help.textContent = lw.dataset.helpOff;
            }
        });
    }
})();
</script>
{% endblock %}
