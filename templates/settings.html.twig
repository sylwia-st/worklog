{% extends 'base.html.twig' %}

{% block title %}Ustawienia – Raport czasu{% endblock %}

{% import '_icons.html.twig' as icons %}
{% block body %}
<span class="eyebrow">Konfiguracja</span>
<h1>Ustawienia</h1>
<p class="sub">Wszystko zapisuje się lokalnie w wolumenie Dockera <code>worklog-data</code>. Połączenia wychodzące: Twoja Jira i – jeśli wpiszesz token – Toggl Track (api.track.toggl.com).</p>

<div class="settings-layout">
<nav class="settings-nav" aria-label="Sekcje ustawień">
    <a href="#sec-jira-conn">Połączenie z Jirą</a>
    <a href="#sec-toggl-conn">Połączenie z Togglem</a>
    {% for section, fields in form %}<a href="#sec-{{ loop.index }}">{{ section }}</a>{% endfor %}
</nav>
<div>
<div class="panel" id="sec-jira-conn" style="scroll-margin-top:86px">
    <h2>{{ icons.i('jira') }}Połączenie z Jirą</h2>
    <div class="actions" style="margin-top:0">
        <form method="post" action="{{ path('settings_jira_test') }}"><button type="submit" {{ not hasTokens.jira_token ? 'disabled' }}>Sprawdź połączenie</button></form>
        <form method="post" action="{{ path('settings_jira_issues') }}"><button type="submit" {{ not hasTokens.jira_token ? 'disabled' }}>Pobierz moje tickety do podpowiedzi</button></form>
        <span class="muted small">{{ hasTokens.jira_token ? 'Token zapisany.' : 'Najpierw zapisz adres i token poniżej.' }} W podpowiedziach: {{ issueCount }} ticketów.</span>
    </div>
</div>
<div class="panel" id="sec-toggl-conn" style="scroll-margin-top:86px">
    <h2>{{ icons.i('toggl') }}Połączenie z Togglem</h2>
    <div class="actions" style="margin-top:0">
        <form method="post" action="{{ path('settings_toggl_test') }}"><button type="submit" {{ not hasTokens.toggl_token ? 'disabled' }}>Sprawdź połączenie</button></form>
        <span class="muted small">{{ hasTokens.toggl_token ? 'Token zapisany – na stronie dnia jest przycisk „Pobierz z Toggla”.' : 'Najpierw zapisz token poniżej (sekcja Toggl).' }}</span>
    </div>
</div>

<form method="post" action="{{ path('settings_save') }}">
    {% for section, fields in form %}
        <fieldset id="sec-{{ loop.index }}">
            <legend>{{ section }}</legend>
            <div class="fields">
            {% for key, f in fields %}
                {% set label = f[0] %}{% set type = f[1] %}{% set help = f[2] %}
                {% set wide = type in ['textarea', 'themes', 'colors'] or key starts with 'slack_' or key ends with '_subject' or key starts with 'plan_phrase' or key in ['jira_jql', 'forma'] %}
                <div class="field{{ wide ? ' wide' }}" id="field-{{ key }}" {{ type == 'colors' and values.theme != 'custom' ? 'hidden' }}>
                    <label {% if type not in ['colors', 'themes'] %}for="{{ key }}"{% endif %}>{{ label }}</label>
                    {% if type == 'textarea' %}
                        <textarea id="{{ key }}" name="{{ key }}" rows="{{ key ends with '_body' ? 7 : 2 }}" class="{{ key ends with '_body' ? 'mono' }}">{{ values[key] }}</textarea>
                    {% elseif type == 'select' %}
                        <select id="{{ key }}" name="{{ key }}">
                            {% for value, name in options[key] %}<option value="{{ value }}" {{ values[key] == value ? 'selected' }}>{{ name }}</option>{% endfor %}
                        </select>
                    {% elseif type == 'themes' %}
                        {% set current = themes[values[key]] is defined ? values[key] : defaultTheme %}
                        <div class="themes" role="radiogroup" aria-label="{{ label }}">
                            {% for group, ids in themeGroups %}
                                <span class="themes-h">{{ group }}</span>
                                {% for id in ids %}
                                    {% set c = id == 'custom' ? customColors : palettes[id] %}
                                    <label class="theme-card" data-id="{{ id }}"{% if themeNotes[id] is defined %} title="{{ themeNotes[id]|capitalize }}"{% endif %} style="--t-bg:{{ c.bg }}; --t-panel:{{ c.panel }}; --t-ink:{{ c.ink }}; --t-muted:{{ c.muted }}; --t-a:{{ c.accent }}; --t-a2:{{ c['accent-2'] }}">
                                        <input type="radio" name="{{ key }}" value="{{ id }}" {{ id == current ? 'checked' }}>
                                        <span class="tc-preview" aria-hidden="true">
                                            <span class="tc-panel"><i class="tc-l1"></i><i class="tc-l2"></i><span class="tc-bars"><i style="height:55%"></i><i style="height:80%"></i><i style="height:65%"></i><i style="height:95%"></i></span><i class="tc-btn"></i></span>
                                        </span>
                                        <span class="tc-name">{{ themes[id] }}</span>
                                        {% if themeNotes[id] is defined %}<small class="tc-game">{{ themeNotes[id] }}</small>{% endif %}
                                    </label>
                                {% endfor %}
                            {% endfor %}
                        </div>
                    {% elseif type == 'colors' %}
                        <div class="colors">
                            {% for name, title in themeVars %}
                                <label><input type="color" name="{{ key }}[{{ name }}]" value="{{ customColors[name] }}" data-var="{{ name }}"> {{ title }}</label>
                            {% endfor %}
                        </div>
                        <p id="contrast-warn" class="flash warning small" style="margin:12px 0 0" hidden></p>
                        <div class="actions" style="margin-top:10px">
                            <label for="theme-base" style="display:inline; margin:0">Zacznij od motywu</label>
                            <select id="theme-base" style="width:auto">
                                {% for id, name in themes %}{% if palettes[id] is defined %}<option value="{{ id }}">{{ name }}</option>{% endif %}{% endfor %}
                            </select>
                            <button type="button" id="theme-load">Wczytaj kolory</button>
                        </div>
                    {% elseif type == 'password' %}
                        <input type="password" id="{{ key }}" name="{{ key }}" value="" autocomplete="new-password" placeholder="{{ hasTokens[key] ? '•••••••• (zapisany)' : '' }}">
                    {% else %}
                        <input type="{{ type }}" id="{{ key }}" name="{{ key }}" value="{{ values[key] }}"{% if type == 'number' %} min="0"{% endif %}>
                    {% endif %}
                    {% if help %}<div class="help">{{ help }}</div>{% endif %}
                </div>
            {% endfor %}
            </div>
        </fieldset>
    {% endfor %}
    <div class="savefloat"><span class="muted small" style="margin-right:auto">Zmiany obowiązują po zapisaniu.</span><button type="submit" class="primary">{{ icons.i('check') }}Zapisz ustawienia</button></div>
</form>
</div>
</div>
{% endblock %}

{% block scripts %}
<script>
    // Podgląd motywu na żywo: kliknięty motyw albo zmiana koloru Własnego od razu przemalowuje stronę (zostaje po zapisaniu).
    // Jasne tło przełącza kolory stanów, ticketów i cienie na wersję dla jasnego tła – jak App\Domain\Theme::css().
    (() => {
        const PALETTES = {{ palettes|json_encode|raw }};
        const STATES = {{ states|json_encode|raw }};
        const SERIES = {{ series|json_encode|raw }};
        const SHADES = {{ shades|json_encode|raw }};
        const root = document.documentElement.style;
        const radios = [...document.querySelectorAll('input[name="theme"]')];
        const inputs = [...document.querySelectorAll('input[type=color][data-var]')];
        const field = document.getElementById('field-theme_custom');
        const card = document.querySelector('.theme-card[data-id="custom"]');
        const warn = document.getElementById('contrast-warn');

        // jak Theme::luminance()
        const luminance = (hex) => [1, 3, 5].map(i => parseInt(hex.substr(i, 2), 16) / 255)
            .map(c => c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4)
            .reduce((sum, c, i) => sum + c * [0.2126, 0.7152, 0.0722][i], 0);
        const contrast = (a, b) => { const [x, y] = [luminance(a), luminance(b)]; return (Math.max(x, y) + 0.05) / (Math.min(x, y) + 0.05); };
        const isLight = (hex) => luminance(hex) >= 0.18;

        const custom = () => Object.fromEntries(inputs.map(i => [i.dataset.var, i.value]));
        const selected = () => (radios.find(r => r.checked) || {}).value;
        const apply = (colors) => {
            const light = isLight(colors.bg);
            root.setProperty('color-scheme', light ? 'light' : 'dark');
            root.setProperty('--shade', SHADES[light ? 'light' : 'dark']);
            for (const [name, value] of Object.entries({...colors, ...STATES[light ? 'light' : 'dark']})) root.setProperty('--' + name, value);
            SERIES[isLight(colors.panel) ? 'light' : 'dark'].forEach((hex, i) => root.setProperty('--s' + (i + 1), hex));
        };
        // miniatura kafelka Własny i ostrzeżenie, gdy tekst będzie słabo czytelny
        const refreshCustom = () => {
            const c = custom();
            if (card) for (const [v, n] of [['--t-bg', 'bg'], ['--t-panel', 'panel'], ['--t-ink', 'ink'], ['--t-muted', 'muted'], ['--t-a', 'accent'], ['--t-a2', 'accent-2']]) card.style.setProperty(v, c[n]);
            if (!warn || !inputs.length) return;
            const low = [['Tekst na tle paneli', 'ink', 'panel', 7], ['Tekst na tle strony', 'ink', 'bg', 7], ['Tekst pomocniczy', 'muted', 'panel', 4.5],
                ['Akcent (linki) na tle paneli', 'accent', 'panel', 4.5], ['Tekst na przyciskach', 'accent-ink', 'accent', 4.5]]
                .filter(([, fg, bg, min]) => contrast(c[fg], c[bg]) < min)
                .map(([label, fg, bg]) => label + ' (' + contrast(c[fg], c[bg]).toFixed(1) + ':1)');
            warn.hidden = !low.length;
            warn.textContent = low.length ? 'Słabo czytelne: ' + low.join(', ') + '. Dobrze, żeby tekst miał kontrast co najmniej 4.5:1 (główny 7:1).' : '';
        };
        const preview = () => {
            const id = selected();
            if (field) field.hidden = id !== 'custom';
            document.documentElement.dataset.theme = id; // własny wygląd motywów z gier (base.html.twig)
            apply(id === 'custom' ? custom() : PALETTES[id]);
        };

        radios.forEach(r => r.addEventListener('change', preview));
        inputs.forEach(i => i.addEventListener('input', () => { refreshCustom(); if (selected() === 'custom') apply(custom()); }));
        const load = document.getElementById('theme-load');
        if (load) load.addEventListener('click', () => {
            const colors = PALETTES[document.getElementById('theme-base').value];
            inputs.forEach(i => { i.value = colors[i.dataset.var]; });
            refreshCustom();
            if (selected() === 'custom') apply(custom());
        });
        refreshCustom();
    })();
</script>
<script>
    // menu sekcji: podświetla sekcję widoczną na ekranie
    (() => {
        const links = [...document.querySelectorAll('.settings-nav a')];
        const byId = Object.fromEntries(links.map(a => [a.hash.slice(1), a]));
        const io = new IntersectionObserver((entries) => {
            for (const e of entries) if (e.isIntersecting) { links.forEach(a => a.classList.remove('on')); byId[e.target.id]?.classList.add('on'); }
        }, {rootMargin: '-90px 0px -65% 0px'});
        Object.keys(byId).forEach(id => { const el = document.getElementById(id); if (el) io.observe(el); });
    })();
</script>
{% endblock %}
