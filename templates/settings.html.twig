{% extends 'base.html.twig' %}

{% block title %}Ustawienia – Raport czasu{% endblock %}

{% block body %}
<h1>Ustawienia</h1>
<p class="sub">Wszystko zapisuje się lokalnie w wolumenie Dockera <code>worklog-data</code>. Jedyne połączenie wychodzące to Twoja Jira.</p>

<div class="panel">
    <h2>Połączenie z Jirą</h2>
    <div class="actions" style="margin-top:0">
        <form method="post" action="{{ path('settings_jira_test') }}"><button type="submit" {{ not hasToken ? 'disabled' }}>Sprawdź połączenie</button></form>
        <form method="post" action="{{ path('settings_jira_issues') }}"><button type="submit" {{ not hasToken ? 'disabled' }}>Pobierz moje tickety do podpowiedzi</button></form>
        <span class="muted small">{{ hasToken ? 'Token zapisany.' : 'Najpierw zapisz adres i token poniżej.' }} W podpowiedziach: {{ issueCount }} ticketów.</span>
    </div>
</div>

<form method="post" action="{{ path('settings_save') }}">
    {% for section, fields in form %}
        <fieldset>
            <legend>{{ section }}</legend>
            {% for key, f in fields %}
                {% set label = f[0] %}{% set type = f[1] %}{% set help = f[2] %}
                <div class="field" id="field-{{ key }}" {{ type == 'colors' and values.theme != 'custom' ? 'hidden' }}>
                    <label {% if type != 'colors' %}for="{{ key }}"{% endif %}>{{ label }}</label>
                    {% if type == 'textarea' %}
                        <textarea id="{{ key }}" name="{{ key }}" rows="{{ key ends with '_body' ? 7 : 2 }}" class="{{ key ends with '_body' ? 'mono' }}">{{ values[key] }}</textarea>
                    {% elseif type == 'select' %}
                        <select id="{{ key }}" name="{{ key }}">
                            {% for value, name in options[key] %}<option value="{{ value }}" {{ values[key] == value ? 'selected' }}>{{ name }}</option>{% endfor %}
                        </select>
                    {% elseif type == 'colors' %}
                        <div class="colors">
                            {% for name, title in themeVars %}
                                <label><input type="color" name="{{ key }}[{{ name }}]" value="{{ themeColors[name] }}" data-var="{{ name }}"> {{ title }}</label>
                            {% endfor %}
                        </div>
                        <div class="actions" style="margin-top:8px">
                            <label for="theme-base" style="display:inline; margin:0">Wczytaj kolory z motywu</label>
                            <select id="theme-base" style="width:auto">
                                {% for id, name in options.theme %}{% if palettes[id] is defined %}<option value="{{ id }}">{{ name }}</option>{% endif %}{% endfor %}
                            </select>
                            <button type="button" id="theme-load">Wczytaj</button>
                        </div>
                    {% elseif type == 'password' %}
                        <input type="password" id="{{ key }}" name="{{ key }}" value="" autocomplete="new-password" placeholder="{{ hasToken ? '•••••••• (zapisany)' : '' }}">
                    {% else %}
                        <input type="{{ type }}" id="{{ key }}" name="{{ key }}" value="{{ values[key] }}"{% if type == 'number' %} min="0"{% endif %}>
                    {% endif %}
                    {% if help %}<div class="help">{{ help }}</div>{% endif %}
                </div>
            {% endfor %}
        </fieldset>
    {% endfor %}
    <div class="actions"><button type="submit" class="primary">Zapisz ustawienia</button></div>
</form>
{% endblock %}

{% block scripts %}
<script>
    // Podgląd motywu na żywo: wybór z listy albo zmiana koloru od razu przemalowuje stronę (zapis – przyciskiem).
    (() => {
        const PALETTES = {{ palettes|json_encode|raw }};
        const select = document.getElementById('theme');
        const field = document.getElementById('field-theme_custom');
        const inputs = [...document.querySelectorAll('input[type=color][data-var]')];
        const root = document.documentElement.style;
        // jak Theme::luminance() – ciemne tło przełącza też kontrolki przeglądarki na ciemne
        const luminance = (hex) => [1, 3, 5].map(i => parseInt(hex.substr(i, 2), 16) / 255)
            .map(c => c <= 0.03928 ? c / 12.92 : ((c + 0.055) / 1.055) ** 2.4)
            .reduce((sum, c, i) => sum + c * [0.2126, 0.7152, 0.0722][i], 0);
        const apply = (colors) => {
            for (const [name, value] of Object.entries(colors)) root.setProperty('--' + name, value);
            root.setProperty('color-scheme', luminance(colors.bg) < 0.18 ? 'dark' : 'light');
        };
        const custom = () => Object.fromEntries(inputs.map(i => [i.dataset.var, i.value]));
        const preview = () => {
            const id = select.value;
            field.hidden = id !== 'custom';
            if (id === 'custom') apply(custom());
            else if (PALETTES[id]) apply(PALETTES[id]);
            else apply(matchMedia('(prefers-color-scheme: dark)').matches ? PALETTES.dark : PALETTES.light);
        };
        select.addEventListener('change', preview);
        inputs.forEach(i => i.addEventListener('input', () => { if (select.value === 'custom') apply(custom()); }));
        document.getElementById('theme-load').addEventListener('click', () => {
            const colors = PALETTES[document.getElementById('theme-base').value];
            inputs.forEach(i => { i.value = colors[i.dataset.var]; });
            apply(custom());
        });
    })();
</script>
{% endblock %}
