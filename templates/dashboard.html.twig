{% extends 'base.html.twig' %}

{% block body %}
<h1>Przegląd</h1>
<p class="sub">Ostatnie 4 tygodnie. Kliknij dzień, żeby go uzupełnić, a nagłówek „Dzień” – żeby odwrócić kolejność.</p>

<div class="actions" style="margin:0 0 18px">
    <a class="btn primary" href="{{ path('today') }}">Uzupełnij dzisiaj</a>
    <a class="btn" href="{{ path('planned') }}">Zgłoś późniejsze przyjście / wcześniejsze wyjście</a>
    <a class="btn" href="{{ path('month_current') }}">Podsumowanie miesiąca</a>
</div>

{% if upcoming is not empty %}
<div class="panel">
    <h2>Nadchodzące zmiany</h2>
    <table>
        {% for p in upcoming %}
            <tr>
                <td>{{ p.date|date('d.m.Y') }} <span class="muted">{{ p.date|pl_day }}</span></td>
                <td>{{ p.typeLabel }}{% if p.fromTime %} od {{ p.fromTime }}{% endif %}{% if p.toTime %} do {{ p.toTime }}{% endif %}</td>
                <td>{% if p.mailDoneAt %}<span class="badge ok">mail ✓</span>{% else %}<a class="badge warn" href="{{ path('planned_show', {id: p.id}) }}">mail do wysłania</a>{% endif %}</td>
            </tr>
        {% endfor %}
    </table>
</div>
{% endif %}

<div class="panel">
    <table>
        <thead><tr><th aria-sort="{{ sort == 'asc' ? 'ascending' : 'descending' }}">
            <a class="sortlink" href="{{ path('dashboard', {sort: sort == 'asc' ? 'desc' : 'asc'}) }}"
               title="{{ sort == 'asc' ? 'Najstarsze na górze – kliknij, żeby pokazać najpierw najnowsze' : 'Najnowsze na górze – kliknij, żeby pokazać najpierw najstarsze' }}">Dzień {{ sort == 'asc' ? '↑' : '↓' }}</a>
        </th><th>W ticketach</th><th>Bilans</th><th>Jira</th><th>Slack</th><th>Mail</th></tr></thead>
        <tbody>
        {% for r in rows %}
            {% set offLabel = r.off and r.off.kind != 'weekend' ? r.off.label : null %}
            <tr class="{{ r.weekend or offLabel ? 'weekend' }}">
                <td><a href="{{ path('day', {date: r.date|date('Y-m-d')}) }}">{{ r.date|date('d.m') }}</a> <span class="muted">{{ r.date|pl_day }}</span>{% if r.date == today %} <span class="badge">dziś</span>{% endif %}
                    {% if offLabel and r.summary is defined %} <span class="badge">{{ offLabel }}</span>{% endif %}</td>
                {% if r.summary is defined %}
                    {% set s = r.summary %}
                    <td>{{ s.loggedMinutes|hm }}</td>
                    <td class="{{ s.kind == 'over' ? 'over' : (s.kind == 'under' ? 'under' : 'okc') }}">{{ s.difference == 0 ? '±0' : s.difference|signed_hm }}</td>
                    <td>{% if r.jiraDone %}<span class="badge ok">✓ {{ r.entries }}</span>{% else %}<span class="badge warn">{{ r.inJira }}/{{ r.entries }}</span>{% endif %}</td>
                    <td>{% if r.day.slackDoneAt %}<span class="badge ok">✓</span>{% else %}<span class="badge warn">—</span>{% endif %}</td>
                    <td>
                        {% if not r.mailNeeded %}<span class="muted small">niepotrzebny</span>
                        {% elseif r.day.mailDoneAt %}<span class="badge ok">✓</span>
                        {% else %}<span class="badge warn">do wysłania</span>{% endif %}
                    </td>
                {% else %}
                    <td colspan="5" class="muted">{{ offLabel ?: (r.date > today ? '' : 'brak raportu') }}</td>
                {% endif %}
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
