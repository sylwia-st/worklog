{% extends 'base.html.twig' %}

{% block title %}Wolne – Raport czasu{% endblock %}

{% block body %}
<h1>Urlopy i święta</h1>
<p class="sub">W dni wolne nie ma przypomnienia o raporcie, a Przegląd zamiast „brak raportu” pokazuje powód.
    Jeśli tego dnia jednak pracujesz, wpisz czas jak zwykle – cały liczy się jako nadgodziny.</p>

<div class="grid">
<form method="post" action="{{ path('absence_add') }}" class="panel">
    <h2>Dodaj dni wolne</h2>
    <div class="row">
        <div><label for="from">Od</label><input type="date" id="from" name="from" value="{{ form.from }}" required></div>
        <div><label for="to">Do (włącznie)</label><input type="date" id="to" name="to" value="{{ form.to }}"></div>
    </div>
    <div class="field" style="margin-top:12px">
        <label for="type">Rodzaj</label>
        <select id="type" name="type">
            {% for value, label in types %}<option value="{{ value }}" {{ form.type == value ? 'selected' }}>{{ label }}</option>{% endfor %}
        </select>
    </div>
    <div class="field">
        <label for="note">Notatka (opcjonalnie)</label>
        <input type="text" id="note" name="note" value="{{ form.note }}" maxlength="255" placeholder="np. odbiór za święto 15.08">
    </div>
    <div class="actions"><button type="submit" class="primary">Dodaj</button></div>
    <p class="muted small" style="margin:10px 0 0">Puste „Do” = jeden dzień. Weekendy i święta w zakresie nie liczą się do dni urlopu.</p>
</form>

<div>
    <div class="panel">
        <h2>Zaplanowane i trwające</h2>
        {% for a in upcoming %}{{ _self.item(a, workDays[a.id]) }}{% else %}<p class="muted">Brak.</p>{% endfor %}
        {% if stats is not empty %}
            <p class="muted small" style="margin:10px 0 0">
                W {{ year }}:
                {% for label, n in stats %}{{ label|lower }} – {{ plural(n, 'dzień roboczy', 'dni robocze', 'dni roboczych') }}{{ not loop.last ? ', ' }}{% endfor %}.
            </p>
        {% endif %}
    </div>

    <div class="panel">
        <h2>Najbliższe święta</h2>
        <table>
            {% set saturdays = [] %}
            {% for day, name in holidays %}
                {% set d = date(day) %}
                {% if d|date('N') == 6 %}{% set saturdays = saturdays|merge([d|date('d.m')]) %}{% endif %}
                <tr class="{{ d|date('N') >= 6 ? 'weekend' }}">
                    <td style="white-space:nowrap">{{ d|date('d.m.Y') }} <span class="muted">{{ d|pl_day }}</span></td>
                    <td>{{ name }}</td>
                </tr>
            {% endfor %}
        </table>
        {% if saturdays is not empty %}
            <p class="small" style="margin:10px 0 0">Święto w sobotę ({{ saturdays|join(', ') }}) daje prawo do innego dnia wolnego –
                wskazuje go pracodawca. Dodaj go tutaj jako „Dzień wolny”.</p>
        {% endif %}
    </div>

    {% if past is not empty %}
        <div class="panel">
            <h2>Minione</h2>
            {% for a in past %}{{ _self.item(a, workDays[a.id]) }}{% endfor %}
        </div>
    {% endif %}
</div>
</div>
{% endblock %}

{% macro item(a, days) %}
    <div style="display:flex; justify-content:space-between; align-items:center; gap:10px; padding:6px 0; border-bottom:1px solid var(--line)">
        <span>{{ a.rangeLabel }} · <strong>{{ a.typeLabel }}</strong>{{ a.note ? ' – ' ~ a.note }}
            <span class="muted small">({{ plural(days, 'dzień roboczy', 'dni robocze', 'dni roboczych') }})</span></span>
        <form method="post" action="{{ path('absence_delete', {id: a.id}) }}"><button type="submit" class="link">Usuń</button></form>
    </div>
{% endmacro %}
