{
    "name": "local/worklog-tool",
    "description": "Lokalne narzędzie do raportowania czasu pracy (Jira, Slack, e-mail).",
    "type": "project",
    "license": "proprietary",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-mbstring": "*",
        "ext-pdo_sqlite": "*",
        "doctrine/dbal": "^4.3",
        "doctrine/doctrine-bundle": "^3.3",
        "doctrine/orm": "^3.7",
        "symfony/console": "8.1.*",
        "symfony/dotenv": "8.1.*",
        "symfony/framework-bundle": "8.1.*",
        "symfony/http-client": "8.1.*",
        "symfony/runtime": "8.1.*",
        "symfony/twig-bundle": "8.1.*",
        "symfony/yaml": "8.1.*",
        "twig/twig": "^3.21"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.5.0"
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    }
}
